<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:paddingBottom="96dp"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tvAllTasksTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All tasks"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <!-- Type filter -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false"
        app:selectionRequired="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeOneTime"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="One-time"
            app:checkedIconVisible="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeRecurring"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recurring"
            app:checkedIconVisible="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Status filter -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All"
            app:checkedIconVisible="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusHideDone"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hide DONE"
            app:checkedIconVisible="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>


    <!-- Time range filter -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRange7"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="±7d"
            app:checkedIconVisible="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRange14"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="±14d"
            app:checkedIconVisible="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRange30"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="±30d"
            app:checkedIconVisible="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
