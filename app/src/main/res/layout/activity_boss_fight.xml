<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:orientation="vertical">

    <!-- Top: Boss + HP -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/petronas_primary_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBossLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boss"
                android:textStyle="bold"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/pbBossHp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:progressDrawable="@drawable/progress_hp"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/tvBossHpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="HP: -" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Arena (boss sprite) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/petronas_primary_container">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivBoss"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_centerInParent="true"
                android:src="@drawable/boss_placeholder"
                android:contentDescription="Boss" />

            <TextView
                android:id="@+id/tvCombatLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="Ready."
                android:alpha="0.85" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom stats + attempts -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/petronas_primary_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserPp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your PP: -" />

            <TextView
                android:id="@+id/tvChance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hit chance: -" />

            <LinearLayout
                android:id="@+id/layoutAttempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <Button
                android:id="@+id/btnAttack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Attack" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
