<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvShakeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.8"
            android:text="Shake your phone to open the chest!" />

        <!-- Chest (start CLOSED) -->
        <ImageView
            android:id="@+id/ivChest"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/chest_closed"
            android:scaleType="fitCenter"
            android:contentDescription="Chest" />

        <!-- Rewards: hidden until shake -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutRewards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/petronas_primary_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:orientation="vertical">

                <!-- Coins row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCoinsIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/coin"
                        android:contentDescription="Coins icon" />

                    <TextView
                        android:id="@+id/tvCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Coins: -" />
                </LinearLayout>

                <!-- Drop row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDropIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/drop"
                        android:contentDescription="Drop icon" />

                    <TextView
                        android:id="@+id/tvDrop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Drop: -" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OK" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp" />

    </LinearLayout>
</ScrollView>
